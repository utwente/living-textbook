{% block skills_row %}
  <div class="card card-collection">
    <div class="card-header font-weight-bold">
      <i class="fa fa-fw fa-chevron-right"></i>
      {{ 'skill._level'|trans({
        '%level%': form.vars.skill_set.value,
        '%set%': form.vars.skill_set.label(),
      }) }}
    </div>

    <div class="card-body pb-0">
      {{ form_widget(form) }}
    </div>
  </div>
{% endblock %}
